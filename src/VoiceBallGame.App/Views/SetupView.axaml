<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VoiceBallGame.App.ViewModels"
             xmlns:svc="using:VoiceBallGame.App.Services"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="VoiceBallGame.App.Views.SetupView"
             x:DataType="vm:SetupViewModel">

    <UserControl.Resources>
        <DataTemplate x:Key="SourceOptionTemplate" DataType="svc:SourceOption">
            <StackPanel Spacing="1">
                <TextBlock Text="{Binding Name}" />
                <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.6" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer>
        <StackPanel Margin="32" Spacing="20" MaxWidth="620" HorizontalAlignment="Center">

            <StackPanel Spacing="4">
                <TextBlock Text="Floating Ball Game" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="{Binding TargetSummary}" Opacity="0.7" />
            </StackPanel>

            <Border Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                    CornerRadius="6" Padding="12"
                    IsVisible="{Binding HasError}">
                <TextBlock Text="{Binding Error}" TextWrapping="Wrap" />
            </Border>

            <StackPanel Spacing="8">
                <TextBlock Text="Flow meter" FontWeight="SemiBold" />
                <ComboBox ItemsSource="{Binding FlowOptions}"
                          SelectedItem="{Binding Flow}"
                          ItemTemplate="{StaticResource SourceOptionTemplate}"
                          HorizontalAlignment="Stretch" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Microphone" FontWeight="SemiBold" />
                <ComboBox ItemsSource="{Binding VolumeOptions}"
                          SelectedItem="{Binding Volume}"
                          ItemTemplate="{StaticResource SourceOptionTemplate}"
                          HorizontalAlignment="Stretch" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="Refresh device list" Command="{Binding RefreshCommand}" />
                <Button Content="Calibrate microphone" Command="{Binding CalibrateCommand}" />
            </StackPanel>

            <Border Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                    CornerRadius="6" Padding="12"
                    IsVisible="{Binding NeedsCalibration}">
                <TextBlock Text="{Binding CalibrationMessage}" TextWrapping="Wrap" />
            </Border>

            <Separator />

            <Grid ColumnDefinitions="*,16,*" RowDefinitions="Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Subject" FontWeight="SemiBold" Margin="0,0,0,8" />
                <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding SubjectId}" Watermark="e.g. P07" />

                <TextBlock Grid.Row="0" Grid.Column="2" Text="Session" FontWeight="SemiBold" Margin="0,0,0,8" />
                <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding SessionId}" Watermark="e.g. baseline" />
            </Grid>

            <StackPanel Spacing="2">
                <TextBlock Text="Trials will be saved to" FontSize="11" Opacity="0.6" />
                <TextBlock Text="{Binding OutputDirectory}" FontFamily="monospace" TextWrapping="Wrap" />
            </StackPanel>

            <Button Content="Begin game"
                    Command="{Binding StartCommand}"
                    Classes="accent"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Padding="0,10" />

            <TextBlock Text="{Binding SettingsSummary}" FontSize="11" Opacity="0.5" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
